# Neo4j Database Configuration
# For Neo4j Aura (Cloud):
NEO4J_URI=neo4j+s://<YOUR_INSTANCE_ID>.databases.neo4j.io
NEO4J_USERNAME=<YOUR_INSTANCE_ID_OR_neo4j>
NEO4J_PASSWORD=<YOUR_AURA_PASSWORD>
NEO4J_DATABASE=

# For Local Neo4j:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password
# NEO4J_DATABASE=neo4j

# App Configuration
APP_NAME=Case-Graph-Intelligence-Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DEBUG=True

# Graph Algorithm & Ingestion Settings
DEFAULT_MAX_PATH_DEPTH=5
ENABLE_GDS=True

# AI Intelligence (Gemini) — Optional
GEMINI_API_KEY=

# Blockchain Ledger — Optional (defaults to data/blockchain_ledger.json)
BLOCKCHAIN_LEDGER_PATH=
